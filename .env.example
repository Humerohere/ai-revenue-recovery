# Copy to .env and fill in. NEVER commit .env.
APP_ENV=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- Database / cache -------------------------------------------------
DATABASE_URL=postgresql+psycopg://arr:arr@localhost:5432/arr
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Security ---------------------------------------------------------
SECRET_KEY=
ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Twilio -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true

# --- AI provider ------------------------------------------------------
AI_PROVIDER=anthropic            # anthropic | openai | fake
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MAX_AI_TURNS=12

# --- Google Calendar --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# --- Business rules (deterministic, never LLM-decided) ----------------
MISSED_CALL_MIN_SECONDS=10
QUIET_HOURS_START=21
QUIET_HOURS_END=8
